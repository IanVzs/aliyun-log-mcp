# ============================================================
# aliyun-log-mcp 配置示例
# 用法：cp .env.example .env  然后按需修改
# 永远不要把真实 AccessKey 提交到 git
# ============================================================

# -------- 阿里云 SLS 接入 --------
# Endpoint 必须与目标 Project 所在 Region 一致；不同 Region 的 endpoint 列表：
#   https://help.aliyun.com/zh/sls/developer-reference/api-endpoints
# 常用：
#   cn-hangzhou.log.aliyuncs.com
#   cn-shanghai.log.aliyuncs.com
#   cn-beijing.log.aliyuncs.com
#   cn-shenzhen.log.aliyuncs.com
#   ap-southeast-111.log.aliyuncs.com
ALIYUN_LOG_ENDPOINT=ap-southeast-1111.log.aliyuncs.com

# 强烈建议使用 RAM 子账号 + 最小权限 (AliyunLogReadOnlyAccess) 申请的 AK
ALIYUN_LOG_ACCESS_KEY_ID=
ALIYUN_LOG_ACCESS_KEY_SECRET=

# 可选：使用 STS 临时凭证时填入；留空则用 AK 模式
ALIYUN_LOG_SECURITY_TOKEN=

# -------- 默认项目 / Logstore --------
# 配置后，调用工具时可不传 project/logstore，省事
ALIYUN_LOG_DEFAULT_PROJECT=
ALIYUN_LOG_DEFAULT_LOGSTORE=

# -------- 查询安全护栏 --------
# 默认时间窗（分钟）：调用时未传 from/to 用最近 N 分钟
DEFAULT_TIME_WINDOW_MINUTES=15
# 单次查询返回行数最大上限
MAX_LINES_PER_QUERY=500
# 单次查询最大时间跨度（小时）；超过则拒绝，防止全表扫
MAX_TIME_RANGE_HOURS=24
# 请求超时（秒）
HTTP_TIMEOUT=30

# -------- 服务模式 --------
# stdio | sse | http
SERVER_MODE=stdio
SERVER_HOST=127.0.0.1
SERVER_PORT=3050
